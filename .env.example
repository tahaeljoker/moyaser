# Database and Backend Server
PORT=5000
NODE_ENV=development
MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/muyassar?retryWrites=true&w=majority
JWT_SECRET=super_secret_jwt_key_change_in_production
CORS_ORIGIN=http://localhost:5173

# Initial Admin Credentials (used by server/seed.js)
ADMIN_EMAIL=admin@muyassar-ra.com
ADMIN_PASSWORD=Admin@123456

# Frontend Public Variables
VITE_WHATSAPP_NUMBER=966500550223
VITE_GOOGLE_MAPS_QUERY=https://maps.google.com/?q=Dammam+Al+Atheer+Park
VITE_API_BASE_URL=http://localhost:5000/api

# Green-API WhatsApp Gateway Integration
WHATSAPP_API_URL=https://api.green-api.com
WHATSAPP_INSTANCE_ID=your_instance_id_here
WHATSAPP_API_TOKEN=your_api_token_here
ADMIN_WHATSAPP_NUMBER=966500550223
SALES_WHATSAPP_NUMBER=966500550223

# Google Sheets Webhook Integration (POST JSON lead payload)
GOOGLE_SHEETS_WEBHOOK_URL=https://script.google.com/macros/s/your_deployment_id/exec
